prefix=/home/noname/svn/output
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libsvn_subr
Description: Subversion General Utility Library
Version: 1.16.0
Requires: apr-util-1, apr-1
Requires.private: sqlite3
Libs: -L${libdir}  -lsvn_subr-1 -L/home/noname/svn/output/lib;-lexpat -L/home/noname/svn/output/lib;-lz        
Cflags: -I${includedir}/subversion-1
