prefix=/home/noname/Downloads/svn/output
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libsvn_ra_svn
Description: Subversion SVN Protocol Repository Access Library
Version: 1.16.0
Requires: apr-util-1, apr-1
Requires.private: libsvn_delta, libsvn_subr
Libs: -L${libdir}  -lsvn_ra_svn-1 -L/home/noname/Downloads/svn/output/lib;-lsasl2
Cflags: -I${includedir}/subversion-1
