{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SVNexus",
  "version": "../package.json",
  "identifier": "com.holdxen.svnexus",
  "build": {
    "beforeDevCommand": "node ./src-tauri/scripts/beforeDev.js && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": {
      "script": "node ./scripts/beforeBundle.js",
      "cwd": "."
    }
  },
  "app": {
    "windows": [
      {
        "title": "SVNexus",
        "width": 1024,
        "height": 700,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "MacOS/svnexus-svn": "./target/svnexus-svn"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/bin/svnexus-svn": "./target/svnexus-svn"
        }
      },
      "deb": {
        "files": {
          "/usr/bin/svnexus-svn": "./target/svnexus-svn"
        }
      },
      "rpm": {
        "epoch": 0,
        "files": {
          "/usr/bin/svnexus-svn": "./target/svnexus-svn"
        },
        "release": "1"
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2MTIxM0QyNjhBN0M0ODIKUldTQ3hLZG8waE1TaHZmN2g5N1hjOHNRd0RuQ0FMUk8zK0UxcmZjVVhvVnhweU1rNGlFK1BqMUgK",
      "endpoints": [
        "https://github.com/holdxen/SVNexus/releases/latest/download/latest.json"
      ]
    }
  }
}
