<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:viewModels="clr-namespace:SVNexus.ViewModels"
             x:DataType="viewModels:ImportDialogModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             MinWidth="500"
             xmlns:inject="clr-namespace:SVNexus.Inject"
             xmlns:components="clr-namespace:SVNexus.Components"
             x:Class="SVNexus.Views.ImportDialog">
    <Grid RowDefinitions="*, Auto">
        <u:Form HorizontalAlignment="Stretch" LabelPosition="Top">
            <!-- <u:Form.ItemsPanel> -->
            <!--     <ItemsPanelTemplate> -->
            <!--         <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, *" /> -->
            <!--     </ItemsPanelTemplate> -->
            <!-- </u:Form.ItemsPanel> -->
            <u:Form.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, *"></Grid>
                </ItemsPanelTemplate>
            </u:Form.ItemsPanel>
            <u:FormItem Label="Path:" Grid.Row="0">
                    <TextBox Text="{Binding Path, Delay=300}" Padding="12 0 0 0 ">
                        <TextBox.Resources>
                            <Thickness x:Key="TextBoxInnerRightContentPadding">0</Thickness>
                        </TextBox.Resources>
                        <TextBox.InnerRightContent>
                            <components:SvgButton Classes="Button" 
                                                  Command="{Binding SelectFolderCommand}" 
                                                  Source="{StaticResource Icons.SelectFolder}" />
                        </TextBox.InnerRightContent>
                    </TextBox>
            </u:FormItem>
            <u:FormItem Label="Url:" Grid.Row="1">
                <TextBox Text="{Binding Url}"></TextBox>
            </u:FormItem>
            <u:FormItem Label="Depth:" Grid.Row="2">
                <u:EnumSelector Value="{Binding Depth}" 
                                HorizontalAlignment="Stretch"
                                EnumType="{x:Static viewModels:ImportDialogModel.DepthType}">
                </u:EnumSelector>
            </u:FormItem>
            <u:FormItem Label="Settings:" Grid.Row="3" >
                <StackPanel Spacing="8">
                    <CheckBox Content="No ignore"></CheckBox>
                    <CheckBox Content="No auto properties"></CheckBox>
                    <CheckBox Content="Ignore unknown node types"></CheckBox>
                </StackPanel>
            </u:FormItem>
            <u:FormItem Grid.Row="4" LabelAlignment="Stretch">
                <u:FormItem.Styles>
                    <Style Selector="u|FormItem">
                        <Setter Property="Template">
                            <ControlTemplate TargetType="u:FormItem">
                                <Grid RowDefinitions="Auto, *">
                                    <Grid
                                        Grid.Row="0"
                                        ColumnDefinitions="*, Auto"
                                        Name="PART_LabelPanel"
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Stretch"
                                        >
                                        <ContentPresenter
                                            Grid.Column="0"
                                            Content="{TemplateBinding Label}"
                                            Background="Transparent"
                                            FontWeight="{DynamicResource TextBlockTitleFontWeight}"/>
                                        <TextBlock Grid.Column="1" 
                                                   Foreground="{DynamicResource FormAsteriskForeground}"
                                            IsVisible="{TemplateBinding IsRequired}"
                                            Text="*" />
                                    </Grid>
                                    <ContentPresenter
                                        Grid.Row="1"
                                        Name="PART_ContentPresenter"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Content="{TemplateBinding Content}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                </u:FormItem.Styles>
                <u:FormItem.Label>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="Filter:"></TextBlock>
                        <components:LoadingSvgButton 
                            ToolTip.Tip="Append .gitignore file content to filter"
                            IsVisible="{Binding AppendAble}"
                            Command="{Binding AppendFilterCommand}"
                            IsLoading="{Binding AppendFilterCommand.IsRunning}"
                            Grid.Column="1" 
                            Classes="ToolButton"
                            Source="{StaticResource Icons.Append}">
                        </components:LoadingSvgButton>
                    </Grid>
                </u:FormItem.Label>
                <TextBox AcceptsReturn="True" 
                         Text="{Binding Filter}"></TextBox>
            </u:FormItem>
            <u:FormItem Classes="GridLayout" Label="Commit message:" Grid.Row="5">
                <TextBox AcceptsReturn="True" 
                         Text="{Binding CommitMessage}"></TextBox>
            </u:FormItem>
        </u:Form>
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto, Auto">
            <Border Grid.Column="0"></Border>
            <Button Grid.Column="1" Content="Cancel" 
                    Command="{Binding CloseCommand}"
                    ></Button>
            <Border Grid.Column="2" Width="4"></Border>
            <Button Grid.Column="3" Classes="Primary" Theme="{StaticResource SolidButton}" Content="Confirm"
                    Command="{Binding ConfirmCommand}"
                    >
            </Button>
        </Grid>
    </Grid>
</UserControl>
